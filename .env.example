# ===================================================================
# ASPLOT CENTER - Variables de entorno (ejemplo)
# Copiar como referencia y definir según el entorno.
# Mientras MYSQL_HOST/USER/PASSWORD no estén definidas,
# la aplicación sigue operando sobre SQLite (respaldo).
# ===================================================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=cambieme
MYSQL_DATABASE=asplot_center

# Selección de configuración Flask: development | production | mysql
FLASK_CONFIG=mysql

# ===================================================================
# SPRINT 7 (PB-12) - Copilot administrativo NL -> SQL
# Todas opcionales: sin COPILOT_API_KEY el copilot funciona con
# plantillas predefinidas (solo lectura, sin llamadas de red).
# ===================================================================

# Cualquier API compatible con OpenAI (OpenAI, DeepSeek, Groq, Ollama...)
#COPILOT_BASE_URL=https://api.openai.com/v1
#COPILOT_MODEL=gpt-4o-mini
#COPILOT_API_KEY=pegar-clave-sin-comillas

# Segundos de espera maxima para la API (default 15)
#COPILOT_TIMEOUT=15

# Maximo de filas por respuesta (default 200)
#COPILOT_MAX_FILAS=200

# Conexion alternativa de SOLO LECTURA (usuario MySQL sin permisos de
# escritura). Si no se define se usa la conexion principal.
#COPILOT_DATABASE_URL=mysql+pymysql://lector:clave@localhost:3306/asplot_center
